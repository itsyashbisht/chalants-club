# ---- Database (Neon pooled connection string in staging/production; local Postgres for dev/tests)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/chalants_dev
# Used by `pnpm test` (integration tests run migrations against this database and truncate it)
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5433/chalants_test

# ---- App
APP_URL=http://localhost:3000
APP_ENV=development            # development | staging | production
OPERATOR_NAME="Chalants Club"
SUPPORT_EMAIL=support@example.com
SUPPORT_HOURS="Mon-Sat, 10:00-18:00 IST"

# ---- Clerk (leave empty to run without auth; sign-in pages then explain that auth is not configured)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Comma-separated emails granted the operator role on first sign-in (pilot bootstrap, audited)
BOOTSTRAP_OPERATOR_EMAILS=

# Local-only auth bypass for browser testing without Clerk. Never honoured when NODE_ENV=production.
# When true and Clerk is not configured, a cookie `dev_user_email` identifies the signed-in user.
AUTH_DEV_BYPASS=false

# ---- Razorpay (Test Mode). Live keys (rzp_live_*) are refused unless PAYMENTS_LIVE_ENABLED=true.
RAZORPAY_MODE=test
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
RAZORPAY_ACCOUNT_ID=
PAYMENTS_LIVE_ENABLED=false

# ---- Scheduler (GET /api/internal/jobs/tick with `Authorization: Bearer <SCHEDULER_SECRET>`)
SCHEDULER_SECRET=change-me
# On Vercel, set CRON_SECRET to the same value: Vercel cron sends it as the bearer token.
CRON_SECRET=change-me

# ---- Email (Resend). Without a key, emails are recorded in the email_deliveries table only.
RESEND_API_KEY=
EMAIL_FROM="Chalants Club <bookings@example.com>"
STAFF_ALERT_EMAIL=ops@example.com
